# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# AUTH_SECRET: HMAC secret key for signing user authentication tokens on the server.
AUTH_SECRET="change_this_secret_on_production_vps"

# FOOTBALL_API_KEY: API-Football v3 (api-sports.io) key ($19/mo Pro Tier - 7,500 req/day).
FOOTBALL_API_KEY=""

# BREVO (SENDINBLUE) TRANSACTIONAL EMAIL SERVICE (Free Tier: 300 emails/day)
BREVO_API_KEY=""
SENDER_EMAIL="quant@oddspira.com"
SENDER_NAME="Oddspira Quant Intelligence"

# STRIPE BANKING & SUBSCRIPTION BILLING (For future Pro/VIP Monetization)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
MONETIZATION_MODE="EARLY_ACCESS_FREE"

# TELEGRAM & DISCORD VIP WEBHOOK AUTO-BROADCAST (>5% EV & T-60 Lineups)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID="@oddspira"
TELEGRAM_VIP_CHAT_ID=""
DISCORD_VIP_WEBHOOK_URL=""

# GOOGLE SEARCH CONSOLE, BING WEBMASTER TOOLS & INDEXNOW INSTANT INDEXING
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""
